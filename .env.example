# Database Connection (PostgreSQL / Neon serverless)
# Leave empty to use local zero-config embedded storage
DATABASE_URL=""

# Neon Auth integration (optional)
NEON_AUTH_URL=""
NEON_AUTH_PROJECT_ID=""

# OpenRouter AI API Key (optional - intelligent heuristic offline engine operates seamlessly if unset)
OPENROUTER_API_KEY=""
OPENROUTER_MODEL="anthropic/claude-3.5-sonnet"

# Application Security
JWT_SECRET="cognitive-os-production-secret-token-key-32-chars-long"
SESSION_EXPIRY_DAYS=30
